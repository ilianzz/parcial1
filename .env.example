# Copia este archivo a .env y completa con tus valores reales.
# Nunca subas el .env real a un repositorio.

# --- Flask ---
SECRET_KEY=cambia-esto-por-una-cadena-aleatoria-larga
JWT_EXP_HORAS=24

# --- MySQL ---
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=mercancia

# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017/
MONGO_DATABASE=mercancia

# --- Cifrado AES-256-GCM ---
# Generar con:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
AES_KEY_BASE64=

# --- Almacenamiento de imágenes en disco (opcional, por defecto ./imagenes) ---
IMAGENES_DIR=./imagenes
